# Secrets
.env
.env.*
!.env.example

# Private chat data: processed pairs and the local vector store
data/
chroma_data/

# Phone numbers: address book, live routing map, and map backups
config/contacts.md
config/relationship_map.json
config/backups/

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Temp files left by an interrupted atomic write (config/*.tmp, .settings.*.tmp)
*.tmp

# Local databases (the approval queue lives in data/agent_state.sqlite3)
*.sqlite3
*.sqlite3-journal

# Bundles and exported packages
*.zip

# Generated by persona/build_persona.py; persona.json is the file the agent reads
persona/style_signals*.json

# Node
node_modules/
npm-debug.log*

# Editor / local tooling
.vscode/
.idea/
.claude/

# Logs
*.log

# Decision logs contain message text
logs/

# WhatsApp session credentials (Baileys multi-file auth) — never commit
auth_info_baileys/

# Kill switch: present = agent stopped (touch to stop, rm to resume)
kill_switch.flag

# Live switches, written by Reply Desk. Local state, never shared: when missing, the code uses
# the safe defaults (dry run on, auto-reply off).
config/settings.json
config/auto_reply.json
